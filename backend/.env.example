# MySQL o MariaDB (el esquema es mysql:// en ambos). Codifica en la URL los caracteres especiales de la contraseña.
DATABASE_URL="mysql://folio:folio_local_dev@127.0.0.1:3306/folio"
# ID de cliente OAuth de Google (tipo "Aplicación web") con http://localhost y http://localhost:5173 como orígenes.
GOOGLE_CLIENT_ID=""
# Correo de Google del propietario: administra usuarios, límites y registro.
OWNER_EMAIL=""
PORT=3001
DATA_DIR=./data
MAX_PAGES=500
CONVERSION_TIMEOUT_MS=120000
SOFFICE_PATH="C:\Program Files\LibreOffice\program\soffice.com"
