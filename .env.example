# Para compose.yaml (cópialo a .env). La base MySQL o MariaDB es externa:
# desde el contenedor, un servidor de tu propio equipo se alcanza como host.docker.internal.
DATABASE_URL=mysql://folio:folio_local_dev@host.docker.internal:3306/folio
GOOGLE_CLIENT_ID=
OWNER_EMAIL=
MAX_PAGES=500
CONVERSION_TIMEOUT_MS=120000
