# Variables para Dokploy -> servicio Compose -> pestaña Environment.
# Copia este bloque allí y reemplaza los <...>. No subas los valores reales a GitHub.

# --- Dominios (con https://, sin barra final) ---
FRONTEND_URL=https://folio.nube-tec.com
API_URL=https://api-folio.nube-tec.com

# --- MySQL (solo letras y números: se usan dentro de DATABASE_URL) ---
MYSQL_DATABASE=folio
MYSQL_USER=folio
MYSQL_PASSWORD=<hex-aleatorio-1>
MYSQL_ROOT_PASSWORD=<hex-aleatorio-2>

# --- Acceso a la app ---
ADMIN_USER=<usuario>
# Resultado de `pnpm auth:hash` (formato scrypt:...:...)
ADMIN_PASSWORD_HASH=<scrypt:...>
# Mínimo 32 caracteres; cambiarlo cierra todas las sesiones.
SESSION_SECRET=<hex-aleatorio-3>

# --- Opcionales ---
# 2 si api-folio pasa por Cloudflare (nube naranja); 1 si es solo DNS (nube gris).
TRUST_PROXY=2
# Cloudflare Free corta las subidas de más de 100 MB: deja un margen. 0 = sin límite (solo con nube gris).
MAX_FILE_MB=95
MAX_PAGES=500
JOB_TTL_HOURS=24
CONVERSION_TIMEOUT_MS=120000
