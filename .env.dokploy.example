# Variables para Dokploy -> servicio Compose -> pestaña Environment.
# Copia este bloque allí y reemplaza los <...>. No subas los valores reales a GitHub.

# --- Dominios (con https://, sin barra final) ---
FRONTEND_URL=https://folio.nube-tec.com
API_URL=https://api-folio.nube-tec.com

# --- Base de datos MySQL o MariaDB (esquema mysql:// en ambos casos) ---
# Codifica los caracteres especiales de la contraseña (p. ej. @ -> %40, $ -> %24).
# Si el servidor exige TLS, añade ?sslaccept=strict al final.
DATABASE_URL=mysql://<usuario>:<clave>@<host>:3306/<base>

# --- Acceso con Google ---
# ID de cliente OAuth (tipo "Aplicación web") con FRONTEND_URL entre los orígenes autorizados.
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
# Correo de Google del propietario: administra usuarios, límites y registro.
OWNER_EMAIL=<correo>@gmail.com

# --- Opcionales ---
MAX_PAGES=500
CONVERSION_TIMEOUT_MS=120000
